# Python & Test Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environments & IDE
.venv/
venv/
env/
.vscode/
.idea/

# OS & Temp Files
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.log

# Ultralytics auto-generated binary label caches (rebuilt automatically at runtime)
dataset/prepared/labels/*.cache

# Temporary runtime uploads & duplicate validation run folders
results/temp_uploads/
runs/

# ==============================================================================
# Dataset Exclusions (~19 GB bulk raw/synthetic videos excluded from GitHub)
# All metadata, prepared YOLO splits, evaluation_videos, and representative
# real/synthetic samples remain tracked. See dataset/README.md for details.
# ==============================================================================

